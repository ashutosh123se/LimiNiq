# ==============================================================================
# LIMINIQ Web Application - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your environment-specific values.
# NEVER commit .env, .env.local, or real production secrets to version control.
# ==============================================================================

# Database Connection (PostgreSQL - Neon, Supabase, or AWS RDS)
DATABASE_URL="postgresql://user:password@hostname:5432/liminiq?sslmode=require"
DIRECT_URL="postgresql://user:password@hostname:5432/liminiq?sslmode=require"

# NextAuth Authentication Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="[REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS]"
NEXTAUTH_URL="https://www.liminiq.com"

# Admin Setup & Seeding (Non-production only)
# Required to access /api/admin/seed in non-production environments
ADMIN_SEED_SECRET="[REPLACE_WITH_HIGH_ENTROPY_SEED_SECRET]"
SEED_ADMIN_PASSWORD="[REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12_CHARS]"
EMAIL_ADMIN="admin@liminiq.com"

# Transactional Email (SendGrid / SMTP)
SENDGRID_API_KEY="[YOUR_SENDGRID_API_KEY]"
EMAIL_FROM="hello@liminiq.com"

# SMTP Fallback (Optional)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="[YOUR_SMTP_PASSWORD]"

# AI & External Auditing APIs
# Google PageSpeed Insights API Key for live Website Audit scoring
PAGESPEED_API_KEY="[YOUR_GOOGLE_PAGESPEED_API_KEY]"
# OpenAI API Key for AI features and chat
OPENAI_API_KEY="[YOUR_OPENAI_API_KEY]"

# Public Configuration & Client Tracking
NEXT_PUBLIC_APP_URL="https://www.liminiq.com"
NEXT_PUBLIC_CONTACT_EMAIL="hello@liminiq.com"
NEXT_PUBLIC_CONTACT_PHONE="+91 9431471654"
NEXT_PUBLIC_WHATSAPP_NUMBER="919431471654"

# Analytics & Verification
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GSC_VERIFICATION="[GOOGLE_SEARCH_CONSOLE_VERIFICATION_TOKEN]"

